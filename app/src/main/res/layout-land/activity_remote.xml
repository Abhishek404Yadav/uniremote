<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape and unfolded phones: the mode switch and the pad (with its columns, and in Full the strip and extra
     keys) on the left; the TV, playback, Back, Home, Keyboard and shortcuts on the right. The left side is a little
     wider, so Full's seven extra keys keep their width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:ignore="NestedWeights"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1.3"
        android:orientation="vertical">

        <include layout="@layout/remote_mode_toggle" />

        <FrameLayout
            android:id="@+id/padArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <include layout="@layout/remote_pad" />

            <include layout="@layout/remote_volume_hud" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/remote_top_bar" />

            <include layout="@layout/remote_banner" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include layout="@layout/remote_media_row" />

            <include layout="@layout/remote_nav_row" />

            <app.libremotetvservice.ui.ShortcutsView
                android:id="@+id/appsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/remote_keyboard_bar" />

            <!-- With the Space above: the buttons sit in the middle of the room the TV's name leaves, beside the pad,
                 rather than at the bottom of a tall screen (an unfolded phone). -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
