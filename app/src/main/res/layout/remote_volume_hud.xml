<?xml version="1.0" encoding="utf-8"?>
<!-- Over the top of the pad, between the side columns (64 dp in from each edge), so it never hides the volume key
     being pressed. -->
<app.libremotetvservice.ui.MaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/volumeHud"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginStart="64dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="64dp"
    android:maxWidth="260dp"
    android:alpha="0"
    android:background="@drawable/bg_hud"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/volumeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_volume_up"
        android:tint="@color/on_surface" />

    <ProgressBar
        android:id="@+id/volumeBar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:progressDrawable="@drawable/progress_volume" />

    <TextView
        android:id="@+id/volumeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="24dp"
        android:gravity="end"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />
</app.libremotetvservice.ui.MaxWidthLinearLayout>
