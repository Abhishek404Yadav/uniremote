<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/settings"
                style="@style/Libremote.Icon"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/savedHeader"
            style="@style/Libremote.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/devices_title" />

        <LinearLayout
            android:id="@+id/saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devices_nearby" />

            <ProgressBar
                android:id="@+id/searching"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/devices_searching"
                android:indeterminateTint="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nearby"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/searchingText"
            style="@style/Libremote.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="@string/devices_searching" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/devices_empty_title"
                android:textColor="@color/on_surface"
                android:textSize="17sp" />

            <TextView
                style="@style/Libremote.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/devices_empty_text" />
        </LinearLayout>

        <Button
            android:id="@+id/addByAddress"
            style="@style/Libremote.Button.Tonal"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="8dp"
            android:drawableTint="@color/on_accent_container"
            android:text="@string/devices_add_by_address" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_settings_remote"
            android:drawablePadding="8dp"
            android:drawableTint="@color/on_surface_muted"
            android:gravity="center"
            android:text="@string/devices_privacy"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
