<?xml version="1.0" encoding="utf-8"?>
<!-- The pad (PadLayout) takes the height the rest leaves, down to a comfortable minimum for its mode; below that, the
     whole remote scrolls instead, for instance with three rows of large shortcuts on a small phone. On a wide screen
     (an unfolded phone held upright, a tablet) the remote keeps a phone's width, centred.
     The root saves no state: @id/root is a LinearLayout in landscape, and its state restored into this ScrollView after
     a rotation crashes (ClassCastException in ScrollView.onRestoreInstanceState). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <com.uniremote.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="480dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <include layout="@layout/remote_top_bar" />

        <include layout="@layout/remote_banner" />

        <include layout="@layout/remote_mode_toggle" />

        <FrameLayout
            android:id="@+id/padArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <include layout="@layout/remote_pad" />

            <include layout="@layout/remote_volume_hud" />
        </FrameLayout>

        <include layout="@layout/remote_volume_row" />

        <include layout="@layout/remote_media_row" />

        <include layout="@layout/remote_nav_row" />

        <com.uniremote.ui.ShortcutsView
            android:id="@+id/appsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <include layout="@layout/remote_keyboard_bar" />
    </com.uniremote.ui.MaxWidthLinearLayout>
</ScrollView>
