<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_accent"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_tv"
            android:tint="@color/on_accent_container" />

        <View
            android:id="@+id/tvOnline"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/ok"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tvMore"
        style="@style/Libremote.Icon"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/on_surface_muted"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/tvChevron"
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/on_surface_muted"
        android:visibility="gone" />
</LinearLayout>
