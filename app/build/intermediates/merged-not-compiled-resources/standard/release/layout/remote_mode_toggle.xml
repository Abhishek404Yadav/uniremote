<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modeToggle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_segment"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/modeSimple"
        style="@style/Libremote.ModeSegment"
        android:drawableStart="@drawable/ic_settings_remote"
        android:text="@string/mode_simple" />

    <TextView
        android:id="@+id/modeDpad"
        style="@style/Libremote.ModeSegment"
        android:drawableStart="@drawable/ic_gamepad"
        android:text="@string/mode_dpad" />

    <TextView
        android:id="@+id/modeTouch"
        style="@style/Libremote.ModeSegment"
        android:drawableStart="@drawable/ic_swipe"
        android:text="@string/mode_touchpad" />

    <TextView
        android:id="@+id/modeFull"
        style="@style/Libremote.ModeSegment"
        android:drawableStart="@drawable/ic_remote"
        android:text="@string/mode_full" />
</LinearLayout>
