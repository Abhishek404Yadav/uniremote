<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/close"
                style="@style/Libremote.Icon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Libremote.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_controls" />

            <Switch
                android:id="@+id/haptics"
                style="@style/Libremote.Switch"
                android:text="@string/settings_haptics" />

            <Switch
                android:id="@+id/volumeKeys"
                style="@style/Libremote.Switch"
                android:text="@string/settings_volume_keys" />

            <Switch
                android:id="@+id/autoKeyboard"
                style="@style/Libremote.Switch"
                android:text="@string/settings_auto_keyboard" />

            <Switch
                android:id="@+id/keepScreenOn"
                style="@style/Libremote.Switch"
                android:text="@string/settings_keep_screen_on" />

            <!-- Shortcuts and Remote guide -->
            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_remote" />

            <LinearLayout
                android:id="@+id/shortcuts"
                style="@style/Libremote.SettingLink">

                <ImageView
                    style="@style/Libremote.SettingLinkIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_apps" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Libremote.SettingLinkTitle"
                        android:text="@string/settings_shortcuts" />

                    <TextView
                        style="@style/Libremote.SettingLinkSummary"
                        android:text="@string/settings_shortcuts_summary" />
                </LinearLayout>

                <ImageView
                    style="@style/Libremote.SettingLinkChevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide"
                style="@style/Libremote.SettingLink">

                <ImageView
                    style="@style/Libremote.SettingLinkIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_menu_book" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Libremote.SettingLinkTitle"
                        android:text="@string/settings_guide" />

                    <TextView
                        style="@style/Libremote.SettingLinkSummary"
                        android:text="@string/settings_guide_summary" />
                </LinearLayout>

                <ImageView
                    style="@style/Libremote.SettingLinkChevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_tvs" />

            <LinearLayout
                android:id="@+id/tvs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Updates: only where Libremote can update itself (standard build, no app store, release key). -->
            <LinearLayout
                android:id="@+id/updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Libremote.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_updates" />

                <Switch
                    android:id="@+id/autoCheck"
                    style="@style/Libremote.Switch"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/checkNow"
                    style="@style/Libremote.SettingLink">

                    <ImageView
                        style="@style/Libremote.SettingLinkIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_update" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Libremote.SettingLinkTitle"
                            android:text="@string/settings_check_now" />

                        <TextView
                            android:id="@+id/checkNowSummary"
                            style="@style/Libremote.SettingLinkSummary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- "Update Libremote Receiver on <TV>", one per TV with an older receiver. -->
                <LinearLayout
                    android:id="@+id/receiverUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:textColor="@color/on_surface"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/report"
                style="@style/Libremote.SettingLink"
                android:layout_marginTop="4dp">

                <ImageView
                    style="@style/Libremote.SettingLinkIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bug_report" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Libremote.SettingLinkTitle"
                        android:text="@string/settings_report" />

                    <TextView
                        style="@style/Libremote.SettingLinkSummary"
                        android:text="@string/settings_report_summary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/privacy"
                style="@style/Libremote.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:text="@string/settings_privacy" />

            <TextView
                style="@style/Libremote.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:text="@string/settings_licence" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
