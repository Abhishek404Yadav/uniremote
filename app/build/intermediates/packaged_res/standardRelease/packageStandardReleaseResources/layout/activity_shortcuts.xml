<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/close"
                style="@style/Libremote.Icon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Libremote.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_title" />

                <!-- The TV whose shortcuts these are; a menu of TVs when several are paired. -->
                <TextView
                    android:id="@+id/tvChooser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:singleLine="true"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">

            <!-- The row as it looks on the remote, framed like a strip of the remote's screen. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preview"
                android:importantForAccessibility="noHideDescendants"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <com.uniremote.ui.ShortcutsView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                style="@style/Libremote.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcuts_look" />

            <TextView
                style="@style/Libremote.Label"
                android:text="@string/shortcuts_style" />

            <LinearLayout
                android:id="@+id/styles"
                style="@style/Libremote.Segments" />

            <TextView
                style="@style/Libremote.Label"
                android:text="@string/shortcuts_size" />

            <LinearLayout
                android:id="@+id/sizes"
                style="@style/Libremote.Segments" />

            <TextView
                style="@style/Libremote.Label"
                android:text="@string/shortcuts_rows" />

            <LinearLayout
                android:id="@+id/rows"
                style="@style/Libremote.Segments" />

            <!-- Everything below is per TV, hidden when no TV is paired. -->
            <LinearLayout
                android:id="@+id/perTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Libremote.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_on_remote" />

                <TextView
                    style="@style/Libremote.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text="@string/shortcuts_on_remote_text" />

                <TextView
                    android:id="@+id/pinnedTitle"
                    style="@style/Libremote.Label"
                    android:text="@string/shortcuts_pinned" />

                <LinearLayout
                    android:id="@+id/pinned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/othersTitle"
                    style="@style/Libremote.Label"
                    android:text="@string/shortcuts_by_use" />

                <LinearLayout
                    android:id="@+id/others"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/addRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/hiddenTitle"
                    style="@style/Libremote.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_hidden" />

                <LinearLayout
                    android:id="@+id/hidden"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Libremote.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_tv_apps" />

                <TextView
                    android:id="@+id/syncText"
                    style="@style/Libremote.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/shortcuts_tv_apps_text" />

                <Button
                    android:id="@+id/sync"
                    style="@style/Libremote.Button.Tonal"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_sync"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/on_accent_container"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:text="@string/shortcuts_sync_button" />

                <TextView
                    style="@style/Libremote.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_start_over" />

                <TextView
                    style="@style/Libremote.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/shortcuts_reset_text" />

                <Button
                    android:id="@+id/reset"
                    style="@style/Libremote.Button.Tonal"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_restart_alt"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/on_accent_container"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:text="@string/shortcuts_reset" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
