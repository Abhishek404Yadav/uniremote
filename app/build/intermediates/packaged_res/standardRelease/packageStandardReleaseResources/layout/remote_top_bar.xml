<?xml version="1.0" encoding="utf-8"?>
<!-- The TV's name and status (the TV menu: switch, add, Find my remote, About this TV), Send files, Power, Settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="4dp">

    <LinearLayout
        android:id="@+id/tvSwitcher"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_text_button"
        android:contentDescription="@string/switch_tv"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Wrap content with a weight: as wide as the name, and shrunk (ellipsized) when the ▾ would not fit. -->
            <TextView
                android:id="@+id/tvName"
                style="@style/Libremote.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:ignore="InefficientWeight"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/on_surface_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/on_surface_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 48 dp each, side by side, so a 360 dp phone still has room for the TV's name. -->
    <ImageButton
        android:id="@+id/sendFiles"
        style="@style/Libremote.Icon"
        android:contentDescription="@string/send_files"
        android:src="@drawable/ic_upload_file" />

    <ImageButton
        android:id="@+id/power"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_round_accent"
        android:contentDescription="@string/key_power"
        android:scaleType="center"
        android:src="@drawable/ic_power_settings_new"
        android:tint="@color/on_accent_container" />

    <ImageButton
        android:id="@+id/settings"
        style="@style/Libremote.Icon"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings" />
</LinearLayout>
