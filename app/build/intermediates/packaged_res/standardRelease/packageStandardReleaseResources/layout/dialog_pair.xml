<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in this dialog is for autofill or password managers: the code is used once (see PrivateEditText). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/pairTitle"
        style="@style/Libremote.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/pairMessage"
        style="@style/Libremote.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <ProgressBar
        android:id="@+id/pairProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:indeterminateTint="@color/accent" />

    <FrameLayout
        android:id="@+id/codeArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/codeBoxes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView style="@style/Libremote.CodeBox" />

            <TextView style="@style/Libremote.CodeBox" />

            <TextView style="@style/Libremote.CodeBox" />

            <TextView style="@style/Libremote.CodeBox" />

            <TextView style="@style/Libremote.CodeBox" />

            <TextView style="@style/Libremote.CodeBox" />
        </LinearLayout>

        <!-- Takes the typing (and pasting) for the boxes, which only display it. Plain text with no suggestions
             and no learning: a password type would keep keyboards quiet too, but makes password managers offer to
             save the code. -->
        <com.uniremote.ui.PrivateEditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/pair_code_description"
            android:cursorVisible="false"
            android:imeOptions="flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="12"
            android:textColor="@android:color/transparent"
            android:textIsSelectable="false" />
    </FrameLayout>

    <TextView
        android:id="@+id/pairError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pairCancel"
            style="@style/Libremote.Button.Text"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/pairAction"
            style="@style/Libremote.Button"
            android:layout_marginStart="8dp"
            android:text="@string/pair_button" />
    </LinearLayout>
</LinearLayout>
