<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="light_bars">false</bool>
    <color name="accent">#FFFF8A3D</color>
    <color name="accent_container">#FF7A3500</color>
    <color name="bg">#FF14161C</color>
    <color name="error">#FFF28B82</color>
    <color name="ok">#FF7BD88F</color>
    <color name="on_accent">#FF2E1200</color>
    <color name="on_accent_container">#FFFFDCC8</color>
    <color name="on_surface">#FFF2F3F5</color>
    <color name="on_surface_muted">#FFA7ACB8</color>
    <color name="ripple">#33FFFFFF</color>
    <color name="scrim">#99000000</color>
    <color name="surface">#FF1F222B</color>
    <color name="surface_high">#FF2B2F3A</color>
    <color name="warn">#FFF5B971</color>
    <style name="Theme.Libremote" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/on_surface_muted</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
        <item name="android:textColorHint">@color/on_surface_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.Libremote.Dialog</item>
    </style>
    <style name="Theme.Libremote.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/on_surface</item>
        <item name="android:buttonBarButtonStyle">@style/Libremote.DialogButton</item>
    </style>
    <style name="Theme.Libremote.Floating" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
        <item name="android:alertDialogTheme">@style/Theme.Libremote.Dialog</item>
    </style>
    <style name="Theme.Libremote.Sheet" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SheetAnimation</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
    </style>
</resources>